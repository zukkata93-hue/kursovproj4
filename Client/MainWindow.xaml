<Window x:Class="Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Загрузка оборудования" Height="720" Width="1100" MinHeight="500" MinWidth="760">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="Логин" VerticalAlignment="Center"/><TextBox x:Name="Login" Width="120" Margin="6,0,12,0" Text="admin"/><TextBlock Text="Пароль" VerticalAlignment="Center"/><PasswordBox x:Name="Password" Width="140" Margin="6,0,12,0"/><Button Content="Войти" Padding="15,5" Click="LoginClick"/><TextBlock x:Name="ConnectionStatus" Margin="15,0" VerticalAlignment="Center"/></StackPanel>
  <TabControl x:Name="Tabs" IsEnabled="False"/>
 </DockPanel>
</Window>
